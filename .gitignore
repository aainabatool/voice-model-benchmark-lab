# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment / secrets
.env

# Generated data - keep folder structure via .gitkeep, ignore contents
artifacts/audio/*
artifacts/transcriptions/*
artifacts/reports/*
datasets/raw/*
datasets/processed/*
!artifacts/**/.gitkeep
!datasets/**/.gitkeep

# Local databases
*.db
*.sqlite3

# Editors / OS
.vscode/
.idea/
.DS_Store

# Test / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
